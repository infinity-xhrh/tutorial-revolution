---
import { resolveApiUrl } from "./protocol.mjs";

const apiUrl = resolveApiUrl(import.meta.env.PUBLIC_TUTORIAL_ASSISTANT_API_URL);
---

<tutorial-assistant data-api-url={apiUrl} data-pagefind-ignore>
    <section class="assistant-panel" aria-label="教程革命模型助教">
        <div class="assistant-heading">
            <div class="assistant-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                    <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H17a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3H9l-5 3V5.5Z" />
                    <path d="m9 9 2 2-2 2m4 0h3" />
                </svg>
            </div>
            <div>
                <p class="assistant-title">教程革命 · 模型助教</p>
                <p class="assistant-model" data-model>DeepSeek V4.1 Flash · high 思考 · 最多 8192 tokens（含思考）</p>
            </div>
        </div>

        <div class="service-state">
            <p data-status role="status" aria-live="polite">{apiUrl ? "正在检查问答服务……" : "本站已关闭模型问答，教程仍可阅读。"}</p>
            <button type="button" data-recheck disabled={!apiUrl}>重新检查</button>
        </div>

        <div class="assistant-conversation" data-conversation role="log" aria-label="与模型助教的对话" aria-live="polite" aria-relevant="additions text" tabindex="0">
            <div class="assistant-welcome" data-welcome>
                <p class="welcome-title">从一个具体问题开始</p>
                <p>说明游戏版本、期望效果和当前现象，必要时附上最小代码片段。</p>
                <div class="example-questions" aria-label="示例问题">
                    <button type="button" data-example>如何建立第一个 Stellaris Mod？</button>
                    <button type="button" data-example>中文本地化只显示键名，怎么排查？</button>
                    <button type="button" data-example>事件中的 ROOT、FROM 和 THIS 有什么区别？</button>
                </div>
            </div>
        </div>

        <form data-chat-form autocomplete="off">
            <label class="question-label" for="tutorial-assistant-question">你的问题</label>
            <textarea id="tutorial-assistant-question" name="question" rows="4" data-question placeholder="例如：Stellaris 4.5 中，事件已触发但没有生成风暴，该检查哪些作用域？" aria-describedby="assistant-input-help assistant-privacy" required disabled={!apiUrl}></textarea>
            <div class="input-info">
                <p id="assistant-input-help">Enter 换行，Ctrl / ⌘ + Enter 发送</p>
                <span data-byte-count>0 / 8192 字节</span>
            </div>
            <p class="input-error" data-input-error role="alert" hidden></p>
            <div class="assistant-actions">
                <button type="button" data-new-chat>新对话</button>
                <button class="send-button" type="submit" data-send disabled>发送问题</button>
            </div>
        </form>

        <p class="assistant-privacy" id="assistant-privacy">点击发送后，问题及有限对话历史会交给教程革命服务并调用 DeepSeek。对话只保留在当前页面内存中。模型回答需结合游戏版本和实际测试核对。</p>
        <noscript><p>模型问答需要启用 JavaScript；本站教程仍可正常阅读。</p></noscript>
    </section>
</tutorial-assistant>

<script>
    import "./client";
</script>

<style>
    tutorial-assistant { display: block; margin-block: 1.5rem; }
    .assistant-panel { border: 1px solid var(--sl-color-gray-5); border-radius: 0.75rem; background: var(--sl-color-bg); overflow: hidden; }
    .assistant-heading { display: flex; align-items: center; gap: 0.85rem; padding: 1.25rem; }
    .assistant-mark { display: grid; place-items: center; flex: 0 0 3rem; height: 3rem; border-radius: 0.75rem; color: var(--sl-color-text-accent); background: var(--sl-color-accent-low); }
    .assistant-mark svg { width: 1.7rem; height: 1.7rem; }
    .assistant-title { font-size: 1.1rem; font-weight: 700; color: var(--sl-color-white); }
    .assistant-model { font-size: 0.8rem; color: var(--sl-color-gray-2); margin-top: 0.2rem; }
    .assistant-panel p { margin-block: 0; }
    .service-state { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.75rem 1.25rem; border-block: 1px solid var(--sl-color-gray-5); background: var(--sl-color-bg-nav); font-size: 0.85rem; }
    .service-state p { flex: 1; }
    .assistant-panel button { font: inherit; border-radius: 0.4rem; border: 1px solid var(--sl-color-gray-4); padding: 0.45rem 0.8rem; background: var(--sl-color-bg); color: var(--sl-color-text); cursor: pointer; line-height: 1.5; }
    .assistant-panel button:hover:not(:disabled) { border-color: var(--sl-color-text-accent); color: var(--sl-color-text-accent); }
    .assistant-panel button:disabled { opacity: 0.55; cursor: not-allowed; }
    .assistant-panel :is(button, textarea, [tabindex]):focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 3px; }
    .service-state button { flex-shrink: 0; padding: 0.3rem 0.65rem; font-size: 0.8rem; }
    .assistant-conversation { min-height: 15rem; max-height: min(65vh, 42rem); overflow: auto; overscroll-behavior: contain; padding: 1.25rem; scrollbar-gutter: stable; }
    .assistant-welcome { padding-block: 0.5rem; }
    .welcome-title { font-size: 1.1rem; font-weight: 600; }
    .assistant-welcome p + p { margin-top: 0.4rem; color: var(--sl-color-gray-2); font-size: 0.9rem; }
    .example-questions { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-top: 1.2rem; }
    .example-questions button { text-align: left; font-size: 0.85rem; }
    form { border-top: 1px solid var(--sl-color-gray-5); padding: 1rem 1.25rem; }
    .question-label { display: block; font-weight: 600; margin-bottom: 0.4rem; }
    textarea { display: block; width: 100%; resize: vertical; min-height: 6rem; max-height: 24rem; padding: 0.8rem; border: 1px solid var(--sl-color-gray-4); border-radius: 0.5rem; background: var(--sl-color-bg); color: var(--sl-color-text); font: inherit; line-height: 1.6; }
    .input-info { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.2rem 0.6rem; margin-top: 0.4rem; color: var(--sl-color-gray-2); font-size: 0.75rem; }
    .input-error { color: var(--sl-color-text); background: var(--sl-color-orange-low); border-radius: 0.3rem; padding: 0.5rem; font-size: 0.85rem; }
    .assistant-actions { display: flex; justify-content: space-between; gap: 0.75rem; margin-top: 0.9rem; }
    .assistant-panel .send-button { background: var(--sl-color-text-accent); color: var(--sl-color-bg); border-color: var(--sl-color-text-accent); font-weight: 600; }
    .assistant-panel .send-button:hover:not(:disabled) { color: var(--sl-color-bg); filter: brightness(1.12); }
    .assistant-privacy { padding: 0 1.25rem 1.25rem; color: var(--sl-color-gray-2); font-size: 0.78rem; line-height: 1.7; }
    noscript p { padding: 1rem; }
    .assistant-conversation :global(.chat-message) { margin-bottom: 1.2rem; padding: 0.9rem 1rem; border-radius: 0.5rem; background: var(--sl-color-bg-nav); border: 1px solid var(--sl-color-gray-5); }
    .assistant-conversation :global(.chat-message[data-role="user"]) { margin-left: 1.5rem; background: var(--sl-color-accent-low); }
    .assistant-conversation :global(.message-label) { font-size: 0.75rem; font-weight: 600; color: var(--sl-color-gray-2); margin-bottom: 0.4rem; }
    .assistant-conversation :global(.message-text) { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; font-family: var(--sl-font-mono); font-size: 0.85rem; line-height: 1.8; tab-size: 4; }
    .assistant-conversation :global(.message-sources) { display: flex; flex-wrap: wrap; gap: 0.4rem 0.9rem; border-top: 1px solid var(--sl-color-gray-5); margin-top: 0.8rem; padding-top: 0.6rem; font-size: 0.78rem; }
    .assistant-conversation :global(.chat-message[data-error]) { border-color: var(--sl-color-orange); }
    @media (max-width: 30rem) {
        .assistant-heading, .assistant-conversation { padding: 1rem; }
        .service-state { padding-inline: 1rem; }
        .assistant-heading { align-items: flex-start; }
        .assistant-model { line-height: 1.6; }
        form { padding-inline: 1rem; }
        .assistant-privacy { padding-inline: 1rem; }
        .assistant-conversation :global(.chat-message[data-role="user"]) { margin-left: 0.5rem; }
    }
</style>
